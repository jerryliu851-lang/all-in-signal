# --- Credentials -----------------------------------------------------------
# Only needed in GitHub Actions (set as a repository secret, never commit it).
# Locally the logged-in Claude Code CLI is used and this can stay empty.
# Create with:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# --- Optional overrides (defaults shown) -----------------------------------
ALLIN_MODEL=claude-opus-5-5
ALLIN_ANALYSIS_EFFORT=high
ALLIN_MATCH_EFFORT=low
ALLIN_LLM_BACKEND=claude-code
ALLIN_DATA_DIR=data
ALLIN_BACKFILL_COUNT=10
ALLIN_CHUNK_THRESHOLD_TOKENS=120000
ALLIN_MAX_BUDGET_USD_PER_CALL=4

# Optional HTTP(S) proxy for YouTube caption fetches if the runner IP is blocked.
# Format: http://user:pass@host:port  (see README "Known limitations")
ALLIN_YT_PROXY=
